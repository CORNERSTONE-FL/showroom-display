# Used by `npm run media:sync` (scripts/media.mjs). Copy to .env and fill in; .env is git-ignored.

# The deployment URL from the Convex dashboard (Settings > URL & Deploy Key), e.g. https://happy-otter-123.convex.cloud
CONVEX_URL=

# Any long random string. Set the same value on the deployment with:
#   npx convex env set MEDIA_UPLOAD_SECRET <value>
MEDIA_UPLOAD_SECRET=

# Optional: where the original photos live. Defaults to ./NEW SHOWROOM
# MEDIA_SOURCE_DIR=
